    {"id": "e", "devanagari": "ए", "iast": "e", "ipa": "/eː/", "kana": "エー", "group": "vowel-diph", "step": 1, "speak": "ए", "note": "常に長め。日本語の「エー」でほぼ通じる。", "audioUrl": "/audio/e.mp3"},
