    {"id": "ca", "devanagari": "च", "iast": "ca", "ipa": "/tʃə/", "kana": "チャ", "group": "palatal", "step": 4, "speak": "च", "series": "無声無気", "note": "日本語の「チャ」。क より少し前寄りで発音する。", "audioUrl": "/audio/ca.mp3"},
    {"id": "tta", "devanagari": "ट", "iast": "ṭa", "ipa": "/ʈə/", "kana": "タ(そり舌)", "group": "retroflex", "step": 4, "speak": "ट", "series": "無声無気", "note": "舌先を上あごの奥に反らせる「タ」。すぐ次の त(歯音)と聞き比べて区別する。", "audioUrl": "/audio/tta.mp3"},
    {"id": "ta", "devanagari": "त", "iast": "ta", "ipa": "/t̪ə/", "kana": "タ(歯)", "group": "dental", "step": 4, "speak": "त", "series": "無声無気", "note": "舌先を上の歯の裏にべったり付ける「タ」。ट より柔らかい音。", "audioUrl": "/audio/ta.mp3"},
    {"id": "na", "devanagari": "न", "iast": "na", "ipa": "/nə/", "kana": "ナ", "group": "dental", "step": 4, "speak": "न", "series": "鼻音", "note": "日本語の「ナ」。最頻出の子音のひとつ。ここでは歯行の鼻音として先出しする。", "audioUrl": "/audio/na.mp3"},
    {"id": "pa", "devanagari": "प", "iast": "pa", "ipa": "/pə/", "kana": "パ", "group": "labial", "step": 4, "speak": "प", "series": "無声無気", "note": "日本語の「パ」。息は弱め。", "audioUrl": "/audio/pa.mp3"},
    {"id": "ma", "devanagari": "म", "iast": "ma", "ipa": "/mə/", "kana": "マ", "group": "labial", "step": 4, "speak": "म", "series": "鼻音", "note": "日本語の「マ」。唇行の鼻音として先出しする。", "audioUrl": "/audio/ma.mp3"},

    {"id": "ya", "devanagari": "य", "iast": "ya", "ipa": "/jə/", "kana": "ヤ", "group": "semivowel", "step": 5, "speak": "य", "note": "日本語の「ヤ」。半母音は派生がなく、この1文字だけで覚えられる。", "audioUrl": "/audio/ya.mp3"},
    {"id": "ra", "devanagari": "र", "iast": "ra", "ipa": "/rə/", "kana": "ラ(巻き舌)", "group": "semivowel", "step": 5, "speak": "र", "note": "軽く舌先を弾く「ラ」。イタリア語の r に近い。", "audioUrl": "/audio/ra.mp3"},
