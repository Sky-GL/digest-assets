    {"id": "sha", "devanagari": "श", "iast": "śa", "ipa": "/ʃə/", "kana": "シャ", "group": "fricative", "step": 5, "speak": "श", "note": "英語の sh。日本語の「シャ」でほぼ通じる。", "audioUrl": "/audio/sha.mp3"},
