    {"id": "ai", "devanagari": "ऐ", "iast": "ai", "ipa": "/ɛː/", "kana": "エァー", "group": "vowel-diph", "step": 2, "speak": "ऐ", "note": "「アイ」ではなく口を広げた「エァー」。ए との差が要注意。", "audioUrl": "/audio/ai.mp3"},
    {"id": "au", "devanagari": "औ", "iast": "au", "ipa": "/ɔː/", "kana": "オァー", "group": "vowel-diph", "step": 2, "speak": "औ", "note": "「アウ」ではなく口を広げた「オァー」。", "audioUrl": "/audio/au.mp3"},

    {"id": "ri", "devanagari": "ऋ", "iast": "ṛ", "ipa": "/r̩/", "kana": "リ", "group": "vowel-special", "step": 3, "speak": "ऋ", "note": "サンスクリット由来の母音。現代ヒンディー語では「リ」と読む。", "audioUrl": "/audio/ri.mp3"},
    {"id": "am", "devanagari": "अं", "iast": "aṃ", "ipa": "/ə̃/", "kana": "アン(鼻音化)", "group": "vowel-special", "step": 3, "speak": "अं", "note": "アヌスヴァーラ。上の点で母音を鼻に抜く、または後続子音と同じ位置の鼻音になる。", "audioUrl": "/audio/am.mp3"},
    {"id": "ah", "devanagari": "अः", "iast": "aḥ", "ipa": "/əh/", "kana": "アハ", "group": "vowel-special", "step": 3, "speak": "अः", "note": "ヴィサルガ。軽い息の「ハ」を添える。語彙は少なめ。", "audioUrl": "/audio/ah.mp3"},

